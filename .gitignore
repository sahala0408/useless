# ───── Python ─────
venv/
env/
.venv/
__pycache__/
*.py[cod]
*.egg-info/

# ───── Secrets ─────
.env
.env.*
*.key
secrets.json

# ───── Database ─────
# SQLite recreates itself on first run (init_db), so the database is not
# source code. Backups from the duplicate-name migration are ignored too.
*.db
*.db-journal
*.sqlite3
*.db.backup-*

# ───── Uploaded images ─────
# These are photos people upload at runtime, not part of the project.
# The folder itself is kept (via .gitkeep) so the backend has somewhere
# to write on a fresh clone.
backend/uploads/*
!backend/uploads/.gitkeep

# ───── Editor / OS ─────
.vscode/*
!.vscode/settings.json
.idea/
*.swp
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store

# ───── Temporary build folders ─────
_b/
_build/
_tmp_build/
*.tmp
*.log
